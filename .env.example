# The database URL is used to connect to your neon database.
POSTGRES_URL="your_neon_connection_string"

# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Random bearer secret used to authenticate Vercel Cron requests
CRON_SECRET="replace-with-a-random-secret"

# Bedrock classification with a model that supports JSON-schema structured output.
# In Vercel, AWS_ROLE_ARN uses short-lived OIDC credentials.
# Locally, omit AWS_ROLE_ARN to use the normal AWS SDK credential chain.
AWS_REGION="us-east-1"
AWS_ROLE_ARN="arn:aws:iam::123456789012:role/finsight-classifier"
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"

# Google OAuth (Get these from Google Cloud Console)
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Logokit Token (Get this from https://logokit.com)
NEXT_PUBLIC_LOGOKIT_TOKEN="your_logokit_token"
